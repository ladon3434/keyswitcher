#include <winver.h>
#include "version.h"

IDI_APP ICON "..\\res\\keyswitcher.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION KS_VERSION_MAJOR, KS_VERSION_MINOR, KS_VERSION_PATCH, 0
PRODUCTVERSION KS_VERSION_MAJOR, KS_VERSION_MINOR, KS_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "KeySwitcher - keyboard layout switch by Ctrl"
            VALUE "FileVersion", KS_VERSION_STRING
            VALUE "InternalName", "keyswitcher"
            VALUE "LegalCopyright", "Copyright (c) 2026 Roman Kovrigin. MIT License."
            VALUE "OriginalFilename", "keyswitcher.exe"
            VALUE "ProductName", "KeySwitcher"
            VALUE "ProductVersion", KS_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
